{
  "name": "tokenbao",
  "version": "1.0.9",
  "description": "AI API Token 节省工具",
  "author": "TokenBao Team",
  "license": "MIT",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "start": "npm run build && npm run build:renderer && electron .",
    "dev": "tsc -p tsconfig.json && electron .",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && cd src/renderer && npx tsc --noEmit",
    "build:renderer": "cd src/renderer && npm install && npm run build",
    "clean": "rm -rf dist release test-data",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "check": "npm run lint && npm run build && npm test",
    "package": "npm run build && npm run build:renderer && electron-builder",
    "package:mac": "npm run build && npm run build:renderer && electron-builder --mac",
    "package:win": "npm run build && npm run build:renderer && electron-builder --win",
    "release": "npm run package"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.21"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "^24.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "jest": "^29.0.0",
    "prettier": "^2.8.8",
    "ts-jest": "^29.0.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.1.3"
  },
  "build": {
    "appId": "com.tokenbao.app",
    "productName": "TokenBao",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Yqghlx",
      "repo": "tokenBao"
    }
  }
}
